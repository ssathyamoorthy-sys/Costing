generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// SQLite has no native enum support in Prisma, so these are plain strings.
// Allowed values are enforced in the application layer (see src/lib/auth.ts,
// src/lib/rates.ts, src/routes/quotes.ts):
//   Role:        PURCHASE | SUPERVISOR | MERCHANDISER | ADMIN | FINANCE_MANAGER
//   RateStatus:  PENDING | APPROVED | REJECTED
//   QuoteStatus: DRAFT | PENDING_APPROVAL | APPROVED | REJECTED | SENT | WON | LOST

model User {
  id           Int      @id @default(autoincrement())
  username     String   @unique
  passwordHash String
  name         String
  email        String?
  role         String
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())

  enteredRates       RawMaterialRate[]           @relation("EnteredRates")
  approvedRates      RawMaterialRate[]           @relation("ApprovedRates")
  materialOverrides  QuoteLineSegmentMaterialOverride[]
  exchangeRates      ExchangeRate[]
  createdQuotes      Quote[]                     @relation("CreatedQuotes")
  approvedQuotes      Quote[]                    @relation("ApprovedQuotes")
  lockedQuotes        Quote[]                    @relation("LockedQuotes")
  uploadedPurchaseOrders Quote[]                 @relation("UploadedPurchaseOrders")
  quoteRevisions      QuoteRevision[]
  notifications      Notification[]
  quoteTemplates     QuoteTemplate[]
  quoteTemplateGroups QuoteTemplateGroup[]
  auditLogs          AuditLog[]
}

model RawMaterial {
  id          Int    @id @default(autoincrement())
  code        String @unique
  description String?

  rates      RawMaterialRate[]
  components ProductYarnComponent[]
  segmentYarn QuoteLineSegmentYarn[]
  overrides  QuoteLineSegmentMaterialOverride[]
  templateSegmentYarn QuoteTemplateSegmentYarn[]
}

model RawMaterialRate {
  id             Int        @id @default(autoincrement())
  rawMaterialId  Int
  rawMaterial    RawMaterial @relation(fields: [rawMaterialId], references: [id])
  pricePerKg     Float
  validFrom      DateTime
  validTo        DateTime?
  status         String   @default("PENDING")
  enteredById    Int
  enteredBy      User       @relation("EnteredRates", fields: [enteredById], references: [id])
  approvedById   Int?
  approvedBy     User?      @relation("ApprovedRates", fields: [approvedById], references: [id])
  approvedAt     DateTime?
  rejectReason   String?
  createdAt      DateTime   @default(now())
}

model ItemType {
  id                 Int    @id @default(autoincrement())
  name               String @unique
  stitchingCostPerKg Float
  packingCostPerKg   Float

  // How an item of this type is sized: DIMENSIONS (default - length x width x GSM, for flat
  // items like towels) or FABRIC_CONSUMPTION (a garment's fabric use isn't a simple
  // rectangle - sq.m consumed per piece is entered directly instead, e.g. bathrobes).
  sizingMethod String @default("DIMENSIONS")
  // Alternative to stitchingCostPerKg for garments, where stitching is a flat per-piece
  // labor cost rather than one that scales with fabric weight. 0 = not used (falls back to
  // stitchingCostPerKg).
  stitchingCostPerPiece Float @default(0)

  quoteLineItems QuoteLineSegmentItem[]
  templateItems  QuoteTemplateSegmentItem[]
}

// Duty Drawback / RoDTEP incentive master, controlled by Supervisor/Admin. Chosen per
// quote-line-item at quote-creation time. The incentive is an internal profit metric only
// (a government export rebate paid to the exporter) - it never changes the FOB price the
// customer is quoted.
model HsnCode {
  id             Int      @id @default(autoincrement())
  description    String
  hsCode         String   @unique
  uom            String
  dbkPct         Float
  rosctlRodepPct Float
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())

  quoteLineItems QuoteLineSegmentItem[]
}

model Product {
  id                     Int      @id @default(autoincrement())
  code                   String   @unique
  name                   String?
  weavingWastagePct      Float
  weavingSizingCostPerKg Float
  firstVelourCharges     Float
  firstVelourLossPct     Float
  secondVelourCharges    Float
  secondVelourLossPct    Float
  weightLossPct          Float
  transportLocalPerKg    Float
  rejectionPct           Float
  // Optional second, sequential rejection stage in the BOM multiplier chain - garment items
  // (e.g. bathrobes) separate "fabric rejection" (above) from a further "final/garment
  // rejection" after cutting & stitching. 0 = not used (flat items like towels).
  secondRejectionPct     Float    @default(0)

  // Color method: PIECE_DYED (default - fabric dyed as one piece after weaving, via the
  // Processing Charge master keyed by color) or YARN_DYED (yarn dyed before weaving, cost
  // carried per yarn-recipe slot instead - see dyeingCostPerKg on ProductYarnComponent /
  // QuoteLineSegmentYarn). weightLossPct/processingCharge above apply to PIECE_DYED only;
  // the three fields below apply to YARN_DYED only.
  colorMethod                String @default("PIECE_DYED")
  yarnDyeingProcessLossPct   Float  @default(0)
  washingCostPerKg           Float  @default(0)
  washingLossPct             Float  @default(0)

  active                 Boolean  @default(true)
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  yarnComponents ProductYarnComponent[]
  accessories    ProductAccessory[]
  quoteLineSegments QuoteLineSegment[]
  templateSegments  QuoteTemplateSegment[]
}

model ProductYarnComponent {
  id            Int    @id @default(autoincrement())
  productId     Int
  product       Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  slot          String  // Ground / Pile / Weft / Scoured (or custom label)
  rawMaterialId Int
  rawMaterial   RawMaterial @relation(fields: [rawMaterialId], references: [id])
  mixingPct     Float
  // Yarn-dyed only: cost/kg to dye this specific slot (different slots can be dyed
  // different shades, e.g. a contrast stripe costs more to dye than the base color).
  dyeingCostPerKg Float @default(0)
  // Yarn-dyed only: a free-text label for which dye batch/shade this row represents, when
  // a single slot (e.g. "Pile") is split across several rows with different dyeing costs
  // (e.g. "VAT Dark", "Light", "White / Undyed"). Purely cosmetic - never used in pricing,
  // which already sums every row's own mixingPct-weighted dyeingCostPerKg regardless of
  // this label (see engine.ts).
  dyeVariant String?
}

model ProcessingCharge {
  id        Int    @id @default(autoincrement())
  color     String @unique
  ratePerKg Float
}

model AccessoryType {
  id   Int    @id @default(autoincrement())
  name String @unique

  productDefaults    ProductAccessory[]
  quoteLineItemOverrides QuoteLineSegmentItemAccessory[]
  templateItemOverrides  QuoteTemplateSegmentItemAccessory[]
}

model ProductAccessory {
  id              Int    @id @default(autoincrement())
  productId       Int
  product         Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  accessoryTypeId Int
  accessoryType   AccessoryType @relation(fields: [accessoryTypeId], references: [id])
  costPerPiece    Float

  @@unique([productId, accessoryTypeId])
}

model Customer {
  id             Int      @id @default(autoincrement())
  name           String   @unique
  // Region: Asia | Europe | UK | US | Oceania | Far East | Domestic (India)
  region         String   @default("Domestic (India)")
  // Comma-separated country names (a customer can span multiple countries), e.g. "India,Nepal"
  countries      String   @default("")
  // Quote currency for this customer, independent of region: INR | USD | GBP | EUR.
  // Domestic (India) customers are always billed in INR regardless of this field (enforced in app code).
  currency       String   @default("INR")
  paymentTerms   String?
  freightTerms   String?
  wcInterestPct  Float
  lcInterestPct  Float
  marginPct      Float
  commissionPct  Float
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())

  quotes Quote[]
  quoteTemplates QuoteTemplate[]
  quoteTemplateGroups QuoteTemplateGroup[]
}

model ExchangeRate {
  id           Int      @id @default(autoincrement())
  currency     String   // USD, GBP, EUR, INR
  ratePerInr   Float    // INR value of 1 unit of currency (INR itself = 1)
  validFrom    DateTime
  enteredById  Int
  enteredBy    User     @relation(fields: [enteredById], references: [id])
  createdAt    DateTime @default(now())

  @@index([currency, validFrom])
}

model Quote {
  id            Int         @id @default(autoincrement())
  quoteNo       String      @unique
  // The customer's own reference number for this enquiry (their RFQ/PO number, etc.) -
  // free text, purely informational, never used in pricing.
  customerEnquiryNo String?
  customerId    Int
  customer      Customer    @relation(fields: [customerId], references: [id])
  status        String      @default("DRAFT")
  createdById   Int
  createdBy     User        @relation("CreatedQuotes", fields: [createdById], references: [id])
  approvedById  Int?
  approvedBy    User?       @relation("ApprovedQuotes", fields: [approvedById], references: [id])
  approvedAt    DateTime?
  // Timeline timestamps for reporting (turnaround times) - set once, when the quote first
  // enters that stage.
  submittedAt   DateTime?
  sentAt        DateTime?
  remarks       String?
  validityDate  DateTime?
  paymentTerms  String?
  freightTerms  String?
  // Single currency for this quote, copied from the customer's currency at creation time
  // (Domestic (India) customers are always INR - enforced on the Customer record itself).
  currency      String      @default("INR")

  // Supervisor-only, per-quote overrides of the customer's standard commercial terms.
  // Null means "use the customer's master value" (the normal case); a non-null value here
  // wins for this quote only and never changes the Customer record itself.
  marginPctOverride     Float?
  commissionPctOverride Float?
  wcInterestPctOverride Float?
  lcInterestPctOverride Float?
  // Overrides the "freightExportPerKg" General Mapping setting (a single global default
  // used by every quote) for this quote only.
  freightExportPerKgOverride Float?

  // Set once, by "Lock & Finalize" (Supervisor/Admin), after negotiation with the customer
  // is done. quoteNo (above) keeps working through every negotiation round; finalReferenceNo
  // is only generated at lock time and never changes again. Once locked, every price-
  // mutating action is blocked for everyone except Admin - see assertNotLocked in routes.
  locked           Boolean   @default(false)
  lockedAt         DateTime?
  lockedById       Int?
  lockedBy         User?     @relation("LockedQuotes", fields: [lockedById], references: [id])
  finalReferenceNo String?   @unique

  // The customer's Purchase Order, attachable once the enquiry is "Converted to Order" -
  // required (enforced in routes/quotes.ts) before "Lock & Finalize" can generate the CVN.
  // One file per quote, stored inline in the SQLite file itself (not a separate uploads\
  // folder) so it rides along with the existing backup/snapshot scripts automatically.
  purchaseOrderFileName     String?
  purchaseOrderMimeType     String?
  purchaseOrderData         Bytes?
  purchaseOrderUploadedAt   DateTime?
  purchaseOrderUploadedById Int?
  purchaseOrderUploadedBy   User?     @relation("UploadedPurchaseOrders", fields: [purchaseOrderUploadedById], references: [id])

  version       Int         @default(1)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  lines     QuoteLine[]
  revisions QuoteRevision[]
}

// A point-in-time snapshot of a quote's pricing, taken automatically right before any
// price-mutating action on a quote that's already been shown to the customer (status
// APPROVED or SENT) - this is how negotiation rounds ("reduced twice before final approval")
// stay visible as history, without needing a separate "start new round" step.
model QuoteRevision {
  id          Int      @id @default(autoincrement())
  quoteId     Int
  quote       Quote    @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  revisionNo  Int
  snapshotJson String  // { lines: [{ lineId, color, qtySets, ratePerSet, targetPrice, marginPctOverride }], quote: { marginPctOverride, commissionPctOverride, wcInterestPctOverride, lcInterestPctOverride, currency } }
  note        String?
  createdById Int
  createdBy   User     @relation(fields: [createdById], references: [id])
  createdAt   DateTime @default(now())

  @@index([quoteId, revisionNo])
}

// A quote line is a "Set": one combined price built from one or more Segments (one per
// yarn quality/Product, e.g. PWD, PDD), each of which can carry one or more sized Items
// (Item Type + L/W/GSM + qty-in-set). Most quotes are the simple case - one Segment, one
// Item, qtySets = the order quantity - but this also models a bundled gift set where e.g.
// a bath towel (PWD) and a hand towel (PDD) are quoted together as one combined-price set.
// Color applies to the whole set (a matched set is dyed one shade), not per item.
model QuoteLine {
  id          Int      @id @default(autoincrement())
  quoteId     Int
  quote       Quote    @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  color       String
  qtySets     Int
  targetPrice Float?

  // Customer's own style/article reference for this Set - free text, independently
  // editable, optionally pre-filled from a loaded recipe/template's name but never tied
  // to it afterwards. Shown on the quote page and in the basic Excel export.
  articleRef String?

  // Supervisor-only, per-Set margin override that wins over the quote-wide override (and
  // ultimately the customer default) for this Set only - used by "Match target price" to
  // hit a specific Set's target without moving the price of any other Set in the quote.
  marginPctOverride Float?

  // Overrides the Processing Charge master (looked up by this Set's color) for this Set
  // only - never changes the shared master, so other quotes using the same color are
  // unaffected.
  processingChargeRatePerKgOverride Float?

  // Rollup of the combined set (sum of all segment-items' piece price * qty-in-set),
  // in INR and the quote's currency - the authoritative per-item figures live on
  // QuoteLineSegmentItem. { ratePerSet: Record<currency, number> }
  costBreakupJson String?

  segments QuoteLineSegment[]
}

model QuoteLineSegment {
  id          Int       @id @default(autoincrement())
  quoteLineId Int
  quoteLine   QuoteLine @relation(fields: [quoteLineId], references: [id], onDelete: Cascade)
  productId   Int
  product     Product   @relation(fields: [productId], references: [id])
  sortOrder   Int       @default(0)

  // Overrides the Product master's process-cost fields for this Set's segment only - never
  // changes the shared Product record, so other quotes using the same Product are unaffected.
  weavingSizingCostPerKgOverride Float?
  firstVelourChargesOverride     Float?
  secondVelourChargesOverride    Float?
  transportLocalPerKgOverride    Float?
  washingCostPerKgOverride       Float?

  // Yarn recipe for this segment - pre-filled from the Product's default recipe when the
  // segment is created, then freely editable by the merchandiser for this quote only.
  yarnComponents    QuoteLineSegmentYarn[]
  items             QuoteLineSegmentItem[]
  materialOverrides QuoteLineSegmentMaterialOverride[]
}

model QuoteLineSegmentYarn {
  id            Int              @id @default(autoincrement())
  segmentId     Int
  segment       QuoteLineSegment @relation(fields: [segmentId], references: [id], onDelete: Cascade)
  slot          String           // Ground / Pile / Weft / Border (or custom label)
  rawMaterialId Int
  rawMaterial   RawMaterial      @relation(fields: [rawMaterialId], references: [id])
  mixingPct     Float
  // Yarn-dyed only: cost/kg to dye this specific slot - see ProductYarnComponent.
  dyeingCostPerKg Float @default(0)
  // Yarn-dyed only: dye batch/shade label for this row - see ProductYarnComponent.
  dyeVariant String?
}

model QuoteLineSegmentItem {
  id         Int              @id @default(autoincrement())
  segmentId  Int
  segment    QuoteLineSegment @relation(fields: [segmentId], references: [id], onDelete: Cascade)
  itemTypeId Int
  itemType   ItemType         @relation(fields: [itemTypeId], references: [id])
  // Flat items (sizingMethod = DIMENSIONS, e.g. towels): both set, pieceWeight computed
  // from L x W x GSM. Garment items (sizingMethod = FABRIC_CONSUMPTION, e.g. bathrobes):
  // both left at 0 (not nullable - avoids a SQLite table-rebuild migration on a widely-
  // referenced table), fabricConsumptionSqm set instead - see below.
  lengthCm   Float
  widthCm    Float
  // Garment items only: fabric required per piece, in sq.m (a tailored pattern isn't a
  // simple rectangle, so this is entered directly rather than computed from L x W). Null/0
  // for flat items.
  fabricConsumptionSqm Float?
  gsm        Float
  qtyPerSet  Int              // how many pieces of this item go into one set

  // Duty Drawback / RoDTEP classification for this item, chosen by the merchandiser at
  // quote-creation time - drives the internal "Profit incl. DBK" figure (Supervisor-only).
  hsnCodeId  Int?
  hsnCode    HsnCode?         @relation(fields: [hsnCodeId], references: [id])

  // Overrides the Item Type master's stitching/packing cost for this item only - never
  // changes the shared Item Type record, so other quotes using the same item type are
  // unaffected.
  stitchingCostPerKgOverride    Float?
  stitchingCostPerPieceOverride Float?
  packingCostPerKgOverride      Float?

  pieceWeightGrams Float?
  qtyKg            Float?     // pieceWeightGrams * qtyPerSet / 1000 - one set's worth
  costBreakupJson  String?    // full CostingBreakup (unit ratePerKg/ratePerPiece etc.)

  accessoryOverrides   QuoteLineSegmentItemAccessory[]
  packagingCharges     QuoteLineSegmentItemPackaging[]
}

model QuoteLineSegmentItemAccessory {
  id              Int                  @id @default(autoincrement())
  itemId          Int
  item            QuoteLineSegmentItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  accessoryTypeId Int
  accessoryType   AccessoryType        @relation(fields: [accessoryTypeId], references: [id])
  costPerPiece    Float

  @@unique([itemId, accessoryTypeId])
}

// Free-text additional packaging charge the merchandiser adds directly on an item -
// no fixed Accessory Type master entry needed, no approval workflow (correction #3).
model QuoteLineSegmentItemPackaging {
  id           Int                  @id @default(autoincrement())
  itemId       Int
  item         QuoteLineSegmentItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  description  String
  ratePerPiece Float
}

model QuoteLineSegmentMaterialOverride {
  id                 Int              @id @default(autoincrement())
  segmentId          Int
  segment            QuoteLineSegment @relation(fields: [segmentId], references: [id], onDelete: Cascade)
  rawMaterialId      Int
  rawMaterial        RawMaterial      @relation(fields: [rawMaterialId], references: [id])
  overridePricePerKg Float
  reason             String?
  setById            Int
  setBy              User             @relation(fields: [setById], references: [id])
  notifiedPurchaseAt DateTime?
  createdAt          DateTime         @default(now())
}

// A saved, reusable "recipe" for a repeat order - the same shape as a QuoteLine (Set ->
// Segment -> Item) but with no pricing. Tied to one customer, named by the merchandiser
// who saved it. Picking one in "Add line" pre-fills the form; submitting computes fresh
// pricing off today's raw material rates and customer terms.
model QuoteTemplate {
  id          Int      @id @default(autoincrement())
  customerId  Int
  customer    Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  name        String
  color       String
  qtySets     Int      @default(1)
  createdById Int
  createdBy   User     @relation(fields: [createdById], references: [id])
  createdAt   DateTime @default(now())

  segments QuoteTemplateSegment[]
  groupMemberships QuoteTemplateGroupMember[]

  @@unique([customerId, name])
}

model QuoteTemplateSegment {
  id         Int           @id @default(autoincrement())
  templateId Int
  template   QuoteTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  productId  Int
  product    Product       @relation(fields: [productId], references: [id])
  sortOrder  Int           @default(0)

  yarnComponents QuoteTemplateSegmentYarn[]
  items          QuoteTemplateSegmentItem[]
}

model QuoteTemplateSegmentYarn {
  id            Int                  @id @default(autoincrement())
  segmentId     Int
  segment       QuoteTemplateSegment @relation(fields: [segmentId], references: [id], onDelete: Cascade)
  slot          String
  rawMaterialId Int
  rawMaterial   RawMaterial          @relation(fields: [rawMaterialId], references: [id])
  mixingPct     Float
  // Yarn-dyed only: cost/kg to dye this slot - see schema.prisma (ProductYarnComponent).
  dyeingCostPerKg Float @default(0)
  // Yarn-dyed only: dye batch/shade label for this row - see ProductYarnComponent.
  dyeVariant String?
}

model QuoteTemplateSegmentItem {
  id         Int                  @id @default(autoincrement())
  segmentId  Int
  segment    QuoteTemplateSegment @relation(fields: [segmentId], references: [id], onDelete: Cascade)
  itemTypeId Int
  itemType   ItemType             @relation(fields: [itemTypeId], references: [id])
  lengthCm   Float
  widthCm    Float
  // Garment items only: fabric required per piece, in sq.m - see QuoteLineSegmentItem.
  fabricConsumptionSqm Float?
  gsm        Float
  qtyPerSet  Int

  accessoryOverrides QuoteTemplateSegmentItemAccessory[]
  packagingCharges   QuoteTemplateSegmentItemPackaging[]
}

model QuoteTemplateSegmentItemAccessory {
  id              Int                      @id @default(autoincrement())
  itemId          Int
  item            QuoteTemplateSegmentItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  accessoryTypeId Int
  accessoryType   AccessoryType            @relation(fields: [accessoryTypeId], references: [id])
  costPerPiece    Float

  @@unique([itemId, accessoryTypeId])
}

model QuoteTemplateSegmentItemPackaging {
  id           Int                      @id @default(autoincrement())
  itemId       Int
  item         QuoteTemplateSegmentItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  description  String
  ratePerPiece Float
}

// A named, reusable group of the per-line QuoteTemplates above, covering a whole repeat
// order (all its Sets at once). Applying a group creates every member line in one shot -
// each line is priced fresh, same as applying a single template, and is a normal editable
// QuoteLine afterwards (add/remove items works with no special handling).
model QuoteTemplateGroup {
  id          Int      @id @default(autoincrement())
  customerId  Int
  customer    Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  name        String
  createdById Int
  createdBy   User     @relation(fields: [createdById], references: [id])
  createdAt   DateTime @default(now())

  members QuoteTemplateGroupMember[]

  @@unique([customerId, name])
}

model QuoteTemplateGroupMember {
  id         Int                @id @default(autoincrement())
  groupId    Int
  group      QuoteTemplateGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  templateId Int
  template   QuoteTemplate      @relation(fields: [templateId], references: [id], onDelete: Cascade)
  sortOrder  Int                @default(0)
}

model GeneralSetting {
  id        Int      @id @default(autoincrement())
  key       String   @unique
  value     String
  updatedAt DateTime @updatedAt
}

model Notification {
  id        Int      @id @default(autoincrement())
  userId    Int
  user      User     @relation(fields: [userId], references: [id])
  type      String
  message   String
  read      Boolean  @default(false)
  emailSent Boolean  @default(false)
  createdAt DateTime @default(now())
}

// Generic change log for the masters (Product, Customer, ProcessingCharge, HsnCode,
// ExchangeRate, GeneralSetting) - who changed what field, from what to what, and when.
// entityLabel is captured at write time (the code/name/key at that moment) so the log
// still reads sensibly even if the entity is later renamed.
model AuditLog {
  id          Int      @id @default(autoincrement())
  entityType  String
  entityId    Int
  entityLabel String
  action      String   // "CREATE" | "UPDATE"
  changesJson String   // JSON array of { field, oldValue, newValue }
  changedById Int
  changedBy   User     @relation(fields: [changedById], references: [id])
  createdAt   DateTime @default(now())

  @@index([entityType, entityId])
  @@index([entityType, createdAt])
}
